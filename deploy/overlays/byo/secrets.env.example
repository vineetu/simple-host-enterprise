# Copy to secrets.env (gitignored). In a real installation these come from
# the External Secrets Operator or the platform's secret store, materialised
# as the Secret named simple-host-secrets with exactly these keys.
OIDC_CLIENT_SECRET=
# One or two "<id>:<base64 32-byte key>" entries, comma-separated for
# rotation: the first signs every new session cookie, every
# entry is tried to verify one already out in a browser. The __Host-
# session cookie has no insecure mode, so this is required even for a
# rehearsal install. Generate a key with `openssl rand -base64 32`.
SESSION_SIGNING_KEY=
# DB_PASSWORD is the owning role migrations run as; DB_APP_PASSWORD is the
# distinct least-privilege role the server itself connects as.
# They must never be the same value.
DB_PASSWORD=
DB_APP_PASSWORD=
# Optional as a pair; omit both when a workload identity supplies credentials.
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
# Optional client-side backup envelope. One or two
# "<id>:<base64 32-byte key>" entries, comma-separated for rotation; leave
# empty to rely on BACKUP_SSE alone. Generate a key with `openssl rand -base64 32`.
BACKUP_ENVELOPE_KEY=
