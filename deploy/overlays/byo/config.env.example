# Copy to config.env. Every value is required unless marked optional.
# Its own registrable domain, never a subdomain of the company's main one
# (docs/install.md section 5).
PUBLIC_BASE_URL=https://simple-host.example.com
SECURE_MODE=true
# Every site is served at <site>.<owner>.<base>. Each owner gets a
# *.<owner>.<base> certificate from this cert-manager ClusterIssuer (your
# internal CA, or ACME with DNS-01); see INSTALL.md, "Site addresses".
# OWNER_CERTS=manual instead means you issue those certificates yourself;
# then delete this line.
OWNER_CERT_ISSUER=REPLACE_WITH_YOUR_CLUSTER_ISSUER
PORT=8080
HTTPS_REDIRECT_PORT=8081
# The ingress controller's pod range, so the client address comes from
# X-Forwarded-For. Left empty it trusts no proxy and every request appears
# to come from the ingress; delete the line to use the built-in private ranges.
TRUSTED_PROXY_CIDRS=

# OIDC sign-in. See docs/install.md for a provider
# checklist (Google is documented there in full); the
# shape here is deliberately provider-agnostic. OIDC_CLIENT_SECRET goes in
# secrets.env, never here.
OIDC_ISSUER=https://accounts.example-idp.com
OIDC_CLIENT_ID=REPLACE_WITH_YOUR_CLIENT_ID
OIDC_SCOPES=openid email profile
# The portable admin path every reference install uses (6.1, 6.5): nothing
# in the ID token can substitute for this list.
ADMIN_EMAILS=REPLACE_WITH_YOUR_PLATFORM_TEAM_ADDRESSES
# Required with Google (the server refuses to start without it), and in
# practice for any multi-tenant provider: without it, anyone with an account
# at that provider can sign in.
ALLOWED_EMAIL_DOMAINS=REPLACE_WITH_YOUR_COMPANY_DOMAIN
SESSION_TTL=8h
SESSION_IDLE=30m

# Managed Postgres. The password goes in secrets.env.
DB_HOST=postgres.internal.example.com
DB_PORT=5432
DB_NAME=simplehost
DB_USER=simplehost
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=/etc/simple-host/db-ca/ca.crt

# The S3-compatible bucket over https that stores every site
# (docs/storage.md; turn on its versioning). Leave the key pair out of secrets.env
# when the platform injects credentials through a workload identity.
BACKUP_STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
BACKUP_STORAGE_REGION=us-east-1
BACKUP_STORAGE_BUCKET=simple-host-backups
BACKUP_STORAGE_PREFIX=backups/

# Server-side encryption on every stored object (design 9.1). AES256 is the
# default and needs nothing else; a KMS-backed store also needs a key id.
BACKUP_SSE=AES256
# BACKUP_SSE=aws:kms
# BACKUP_SSE_KEY_ID=arn:aws:kms:us-east-1:111111111111:key/REPLACE_ME

# Optional client-side envelope: leave unset to rely on BACKUP_SSE alone.
# Set in secrets.env, not here — it is a secret, not configuration.
# BACKUP_ENVELOPE_KEY=k1:REPLACE_WITH_A_BASE64_32_BYTE_KEY

# Optional idle-site cleanup (off by default): sites unused for this many
# days are marked and move to Recently deleted IDLE_CLEANUP_GRACE_DAYS (30)
# days later unless kept.
# IDLE_CLEANUP_DAYS=365
# With it, optionally email owners: SMTP_URL goes in secrets.env (it carries
# a password); SMTP_FROM is the sender.
# SMTP_FROM=Simple Host <hosting@example.com>

# Optional operational times and limits, shown at their defaults
# (docs/configuration.md, "Operational times and limits"). A value out of
# range refuses startup; everything people and agents are told follows the
# value set here.
# DELETED_RETENTION_DAYS=30
# IDLE_CLEANUP_GRACE_DAYS=30
# IDLE_CLEANUP_MAX_EMAILS=0
# PREVIEW_LINK_TTL=1h
# EXPORT_LINK_TTL=10m
# API_KEY_DEFAULT_DAYS=90
# API_KEY_EXPIRY_WARNING_DAYS=14
# MAX_TEAMS_PER_PERSON=10
# MAX_TEAM_MEMBERS=50
# MAX_SITE_VIEWERS=50
# Raise the ingress body-size limit (ingress-patch.yaml) with this one.
# MAX_ARCHIVE_BYTES=104857600
# MAX_FILES_PER_SITE=50000
# UPLOAD_CONCURRENCY=2
# SEARCH_TELEMETRY_RETENTION_DAYS=180
# SEARCH_SESSION_MAX_AGE=4320h
# Rate limits: <burst>/<interval>, one line per limiter (the table in
# docs/configuration.md names them all).
# RATE_LIMIT_AUTH_CLIENT=20/5s
# RATE_LIMIT_AUTH_EMAIL=5/50s

# Every other optional setting, commented out at its default and grouped as
# docs/advanced/ groups them (each page explains its settings with recipes).

# --- Server and addresses (docs/advanced/server-and-addresses.md) ---
# The install's own Ingress, which each owner's Ingress copies its class and
# annotations from.
# OWNER_INGRESS_TEMPLATE=simple-host
# How often the reconciler applies owner Ingresses and records certificate
# readiness.
# OWNER_HOSTS_INTERVAL=15s
# Extra hostnames (comma-separated) no person or team may take as a name, on
# top of the built-in ones.
# RESERVED_LABELS=

# --- Accounts and sign-in (docs/advanced/accounts-and-sign-in.md) ---
# The ID token claim read as the person's email address. The provider must
# vouch that it is verified.
# OIDC_EMAIL_CLAIM=email
# A claim to derive usernames from. Empty: the part of the email before the
# @.
# OIDC_USERNAME_CLAIM=
# A claim that makes someone an admin when it holds OIDC_ADMIN_VALUE. Set
# both or neither.
# OIDC_ADMIN_CLAIM=
# The value of OIDC_ADMIN_CLAIM that makes someone an admin.
# OIDC_ADMIN_VALUE=
# Allows a plain-HTTP identity provider. Local evaluation only; never on a
# real install.
# OIDC_INSECURE_ALLOWED=false
# The domain hint sent to the provider, to narrow its account chooser. It
# never authorizes anyone.
# OIDC_HINT_DOMAIN=
# Where an AI app connecting to /mcp may be sent back after sign-in, comma-
# separated.
# OAUTH_REDIRECT_HOSTS=chatgpt.com,claude.ai,vscode.dev,localhost,cursor://anysphere.cursor-mcp
# How long an AI app's access token works before it refreshes.
# OAUTH_ACCESS_TTL=1h
# How long an AI app stays connected before the person signs in at the
# identity provider again.
# OAUTH_REFRESH_TTL=720h
# The longest lifetime an API key (for CI and automation) may be minted
# with.
# API_KEY_MAX_DAYS=365
# API keys minted per person (counted across replicas).
# RATE_LIMIT_API_KEY_MINT=30/10s
# AI app registrations per client address (counted across replicas).
# RATE_LIMIT_OAUTH_REGISTER=30/10s
# AI app token requests per client address (counted across replicas).
# RATE_LIMIT_OAUTH_TOKEN=120/500ms

# --- Access and teams (docs/advanced/access-and-teams.md) ---
# How many different admins must approve opening a site to the network (no
# sign-in).
# NETWORK_ACCESS_APPROVALS=1
# What a site's owner sees of its visits: counts (views and distinct
# viewers), owner (each visit and who), or admin (nothing; admins only).
# ACCESS_LOG_VISIBILITY=counts
# Admin actions per client address.
# RATE_LIMIT_ADMIN_CLIENT=10/10s
# Admin actions per admin.
# RATE_LIMIT_ADMIN_IDENTITY=10/10s

# --- Sites and versions (docs/advanced/sites-and-versions.md) ---
# Sites one person or team may have. 0 is unlimited.
# QUOTA_MAX_SITES=1000
# Storage one person or team may use, every kept version and uploaded file
# included. 0 is unlimited.
# QUOTA_MAX_BYTES=10737418240
# Versions kept per site; older ones are removed after each deploy.
# QUOTA_MAX_VERSIONS=5
# A clamd scanner (host:port) that checks every uploaded file before it is
# stored. A scanner that is down refuses uploads.
# CLAMD_ADDR=
# How long the scan of one file may take.
# CLAMD_TIMEOUT=30s
# The largest file a page may upload.
# ASSET_MAX_FILE_BYTES=26214400
# Uploaded files one site may hold, in bytes.
# ASSET_MAX_SITE_BYTES=524288000
# Uploaded files one site may hold.
# ASSET_MAX_SITE_COUNT=5000
# Management API calls per client address.
# RATE_LIMIT_MANAGEMENT_CLIENT=60/1s
# Management changes per person.
# RATE_LIMIT_MANAGEMENT_USER=30/10s
# Site searches per network peer.
# RATE_LIMIT_SEARCH_QUERY_PEER=200/50ms
# Site searches per search session.
# RATE_LIMIT_SEARCH_QUERY_SESSION=60/1s

# --- Saved data (docs/advanced/saved-data.md) ---
# Saved-data writes per client.
# RATE_LIMIT_STATE_CLIENT=60/1s
# Saved-data writes per site.
# RATE_LIMIT_STATE_SITE=60/1s
# Saved-data reads per client.
# RATE_LIMIT_STATE_READ_CLIENT=120/500ms
# Saved-data reads per site.
# RATE_LIMIT_STATE_READ_SITE=300/200ms

# --- Cleanup and retention (docs/advanced/cleanup-and-retention.md) ---
# How long the audit log is kept.
# AUDIT_RETENTION_DAYS=400
# How long the access log, and ended sessions with their IP and browser, are
# kept.
# ACCESS_LOG_RETENTION_DAYS=90

# --- Storage and backups (docs/advanced/storage-and-backups.md) ---
# The least-privilege role the server connects as (the manifest sets
# simplehost_app).
# DB_APP_USER=
# Allows a database without verified TLS. Local evaluation only.
# DB_INSECURE_ALLOWED=false
# Set by the in-cluster evaluation Postgres, which nothing backs up; logs a
# warning at every start.
# DB_INCLUSTER_EVALUATION=false
# Allows a plain-HTTP bucket endpoint. Local evaluation only.
# BACKUP_STORAGE_INSECURE_ALLOWED=false
# Keeps reading objects written before the envelope key was added, until
# reencrypt has covered them.
# BACKUP_ENVELOPE_PLAINTEXT_ALLOWED=false
# The pod-local cache of site versions, emptied on start.
# CACHE_DIR=/var/cache/simple-host
# Size of that cache. Size its volume at about three times this.
# CACHE_MAX_BYTES=1073741824

# --- Observability (docs/advanced/observability.md) ---
# The port of the separate /metrics listener (Prometheus); not exposed by
# the Service or Ingress.
# METRICS_PORT=9090
