# Copy to secrets.env (gitignored) or let `make local-secrets` generate one
# with random values. Every value is required.
# DB_PASSWORD is the owning role migrations run as; DB_APP_PASSWORD is the
# least-privilege application role the server itself connects as. The two must differ so a compromised server process never holds the
# owning role's credential.
DB_PASSWORD=replace-with-a-long-random-string
DB_APP_PASSWORD=replace-with-a-different-long-random-string
BACKUP_STORAGE_ACCESS_KEY_ID=simplehost
BACKUP_STORAGE_SECRET_ACCESS_KEY=replace-with-a-long-random-string
# The in-cluster MinIO's own single-key auto-encryption backend: without it,
# MinIO refuses any PutObject that carries an SSE header at all (see the
# comment in deploy/components/minio/statefulset.yaml). "<name>:<base64
# 32-byte key>"; generate the key with `openssl rand -base64 32`.
MINIO_KMS_SECRET_KEY=local-sse-key:replace-with-a-base64-32-byte-key
# Optional: uncomment to prove the client-side backup envelope locally.
# One "<id>:<base64 32-byte key>" entry; generate with
# `openssl rand -base64 32`.
# BACKUP_ENVELOPE_KEY=local1:replace-with-a-base64-32-byte-key
# Must match deploy/components/dex/configmap.yaml's staticClients[0].secret
# exactly; both sides are fixed, published, local-only values.
OIDC_CLIENT_SECRET=local-dex-client-secret-96808aacbcb9ec41
# One "<id>:<base64 32-byte key>" entry; generate with `openssl rand -base64
# 32`. The session cookie has no insecure mode, so this is
# required even here.
SESSION_SIGNING_KEY=local1:replace-with-a-base64-32-byte-key
