# Local cluster configuration. Every value here is plain; secrets.env holds
# the rest. The hostname resolves to 127.0.0.1 through public DNS (nip.io);
# sslip.io spells the same address as simple-host.127.0.0.1.sslip.io if nip.io
# is unreachable, and needs the certificate reissued for that name.
PUBLIC_BASE_URL=https://simple-host.127-0-0-1.nip.io
SECURE_MODE=true
PORT=8080
HTTPS_REDIRECT_PORT=8081

# OIDC sign-in. Dex is the automated-test provider here — its
# issuer is the in-cluster Service DNS name; see
# deploy/components/dex/configmap.yaml for why. Swap OIDC_ISSUER/
# OIDC_CLIENT_ID/OIDC_CLIENT_SECRET (and remove the dex component) to
# rehearse against Google instead (docs/install.md section 4).
OIDC_ISSUER=http://dex.simple-host.svc.cluster.local:5556
# In-cluster Dex speaks plain http; permitted here and only here.
OIDC_INSECURE_ALLOWED=true
OIDC_CLIENT_ID=simple-host-local
OIDC_SCOPES=openid email profile
# Both of Dex's static test accounts are @example.com; admin@example.com is
# additionally the one ADMIN_EMAILS names, so sign-in as it and sign-in as
# person@example.com are the two smoke-tested paths (admin, non-admin).
ADMIN_EMAILS=admin@example.com
ALLOWED_EMAIL_DOMAINS=example.com
SESSION_TTL=8h
SESSION_IDLE=30m

# The in-cluster Postgres component reads DB_USER and DB_NAME too.
DB_HOST=postgres.simple-host.svc.cluster.local
DB_PORT=5432
DB_NAME=simplehost
DB_USER=simplehost
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=/etc/simple-host/db-ca/ca.crt

# MinIO inside the cluster. Plain http is permitted here and only here.
BACKUP_STORAGE_ENDPOINT=http://minio.simple-host.svc.cluster.local:9000
BACKUP_STORAGE_REGION=us-east-1
BACKUP_STORAGE_BUCKET=simple-host-backups
BACKUP_STORAGE_PREFIX=backups/
BACKUP_STORAGE_INSECURE_ALLOWED=true
