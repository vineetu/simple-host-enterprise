# Build output
/bin/
/simple-host
/server
*.tar.gz

# Local cluster material: generated per machine, never committed
deploy/overlays/*/secrets.env
deploy/overlays/*/config.env.local
deploy/overlays/*/tls.crt
deploy/overlays/*/tls.key
deploy/overlays/*/db-ca.crt
deploy/overlays/byo/config.env
deploy/overlays/staging/config.env
deploy/overlays/production/config.env

# Editor / OS noise
.DS_Store

# Terraform quick setup (deploy/terraform/<cloud>): providers, local state and
# the generated overlay stay on the machine that ran it
deploy/terraform/*/.terraform/
deploy/terraform/*/.work/
deploy/terraform/*/*.tfvars
deploy/terraform/*/*.tfstate*
deploy/terraform/*/zz_*.tf
